{
  "name": "pcb-design-sandbox",
  "version": "1.0.0",
  "description": "A tscircuit component package",
  "main": "index.circuit.tsx",
  "keywords": [
    "tscircuit",
    "circuit",
    "pcb",
    "electronics"
  ],
  "scripts": {
    "dev": "tsci dev",
    "build": "tsci build",
    "snapshot": "tsci snapshot",
    "snapshot:update": "tsci snapshot --update",
    "start": "tsci dev",
    "typecheck": "tsc --noEmit",
    "export:3d": "tsci export index.circuit.tsx -f glb -o dist/3d/board.glb && node scripts/glb-to-stl.mjs dist/3d/board.glb dist/3d/board_full.stl && node scripts/glb-to-stl.mjs dist/3d/board.glb dist/3d/pcb_only.stl --only \"^Box0$\"",
    "render:top": "node scripts/render-top-view.mjs"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "tscircuit": "^0.0.2351",
    "typescript": "^5.0.0"
  }
}
