		(property "Description" "The 24 V→5.02 V synchronous buck [[COL-COTS-0039]] LM61460, SYNC-locked at 1.00 MHz (50× motor PWM). Chain and rationale: [[Main-Board-01 Power]]; layout: docs/design/parts/LM61460.md."
			(at 132.08 132.08 0)
			(hide yes)
			(show_name no)
			(do_not_autoplace no)
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
