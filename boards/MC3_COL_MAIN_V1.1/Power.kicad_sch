			)
		)
		(property "Note" "24 V -> 5 V synchronous buck, 6 A, VQFN-HR-14 (RJR). fSW set ~1 MHz by R41 (RT 13.3k), synchronized to BUCK_SYNC (PB4 / LPTIM1_CH2, 1.00 MHz = 50x the 20 kHz motor PWM) AC-coupled through C51 so the ripple is phase-locked to the IPROPI sample point. EN UVLO via R42/R43 (rising ~16 V). Vout = 1 V x (1 + R45/R46) = 5.02 V. Hot loop C48/C49/C50 -> VIN1/VIN2 -> PGND tight; thermal vias under the package. Datasheet SNVSBD5D Table 9-2, 1000 kHz / 5 V row."
			(at 101.6 140.97 0)
			(hide yes)
			(show_name no)
			(do_not_autoplace no)
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
